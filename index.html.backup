                    <img src="Prinç buhari 5kg ön.jpeg" alt="Pirinç Buharı 5 KG" class="img-responsive hero-img mb-2" width="200" height="200">
                    <figcaption class="text-sm font-medium text-center">Pirinç Buharı<br>5 KG</figcaption>
                </figure>
                <figure class="hero-product flex flex-col items-center">
                    <img src="Prinç buhari 10kg ön.jpeg" alt="Pirinç Buharı 10 KG" class="img-responsive hero-img mb-2" width="200" height="200">
