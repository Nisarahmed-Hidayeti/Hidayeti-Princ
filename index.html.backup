                </article>
                <!-- Pirinç Buharı 5 KG -->
                <article class="product-card glass flex flex-col items-center p-6 text-center">
                    <img src="Prinç buhari 5kg ön.jpeg" alt="Pirinç Buharı 5 KG ön" class="product-img mb-4" width="260" height="260">
                    <img src="Prinç buhari 5kg arka.jpeg" alt="Pirinç Buharı 5 KG arka" class="product-img mt-2" width="260" height="260">
                    <h3 class="text-xl font-semibold mb-3">Pirinç Buharı</h3>
                    <p class="text-base mb-4">5 KG paketli seçilmiş pirinç</p>
                    <a href="https://wa.me/905325615757" class="btn btn-outline">Sipariş Ver</a>
                </article>
                <!-- Pirinç Buharı 10 KG -->
                <article class="product-card glass flex flex-col items-center p-6 text-center">
                    <img src="Prinç buhari 10kg ön.jpeg" alt="Pirinç Buharı 10 KG ön" class="product-img mb-4" width="260" height="260">
                    <img src="Prinç buhari 10kg arka.jpeg" alt="Pirinç Buharı 10 KG arka" class="product-img mt-2" width="260" height="260">
                    <h3 class="text-xl font-semibold mb-3">Pirinç Buharı</h3>
                    <p class="text-base mb-4">10 KG paketli seçilmiş pirinç</p>
                    <a href="https://wa.me/905325615757" class="btn btn-outline">Sipariş Ver</a>
                </article>
            </div>
        </div>
