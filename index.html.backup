        <div class="container">
            <h2 class="heading-fluid text-center mb-12">Ürünlerimiz</h2>
            <div class="grid md:grid-cols-2 gap-8">
                <!-- Sıla Hidayeti 10 KG -->
                <article class="product-card glass flex flex-col items-center p-6 text-center">
                    <img src="Sıla hidayeti 10kg ön.jpeg" alt="Sıla Hidayeti Pirinç 10 KG ön" class="product-img mb-4" width="260" height="260">
                    <img src="Sıla hidayeti 10kg arka.jpeg" alt="Sıla Hidayeti Pirinç 10 KG arka" class="product-img mt-2" width="260" height="260">
