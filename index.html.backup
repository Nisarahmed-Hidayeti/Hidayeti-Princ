            <path d="M20.1 3.9C17.9 1.7 15 .5 12 .5C5.8.5.7 5.6.7 11.9c0 2 .5 3.9 1.5 5.6L.6 23.4l6-1.6c1.3.5 2.6.6 4 .6.5 0 1 0 1.5-.1l6.3-6.3c1.7-.9 3.5-1.9 4.2-2.2l1.5-.5v.1c0 4.1 3.3 7.5 7.5 7.5s7.5-3.4 7.5-7.5c0-4.1-3.3-7.5-7.5-7.5z" fill="#25D366"/>
