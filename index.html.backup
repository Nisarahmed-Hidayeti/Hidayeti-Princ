    <!-- Quality Section -->
    <section id="quality" class="bg-bg-secondary py-16 animate-on-scroll">
        <div class="container">
            <h2 class="heading-fluid text-center mb-8">Kalitemiz</h2>
            <div class="grid md:grid-cols-3 gap-6 text-center">
                <div class="quality-item">
                    <h3 class="text-lg font-semibold mb-3">Seçilmiş Ürün</h3>
                    <p>Her pirinç değeri, en yüksek standartlara göre seçilir.</p>
                </div>
                <div class="quality-item">
                    <h3 class="text-lg font-semibold mb-3">Geleneksel İş</h3>
                    <p>Üretimde zamanın farkını bilen el emekleri kullanırız.</p>
                </div>
                <div class="quality-item">
                    <h3 class="text-lg font-semibold mb-3">Güvenli Paketleme</h3>
                    <p>Ürünlerimiz, hygienik ortamlarda özel ambalajlar ile paketlenir.</p>
                </div>
            </div>
        </div>
